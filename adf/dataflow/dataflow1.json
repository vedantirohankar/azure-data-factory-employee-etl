{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_ADLS_Employee2",
						"type": "DatasetReference"
					},
					"name": "empsource"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "derivedcol"
				}
			],
			"scriptLines": [
				"source(output(",
				"          EmpID as short,",
				"          EmpName as string,",
				"          Department as string,",
				"          Salary as double,",
				"          LastModifiedDate as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> empsource",
				"empsource derive(Salary = Salary * 12,",
				"          Department = \"IT\") ~> derivedcol"
			]
		}
	}
}